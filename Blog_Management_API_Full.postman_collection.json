{
  "info": {
    "name": "Blog Management API - Full Collection",
    "description": "Full endpoint coverage for the Blog Management API: auth, post CRUD (incl. pagination/search/image upload), comments, and likes. No real credentials are stored here -- fill in {{demo_username}}/{{demo_email}}/{{demo_password}} and run Auth > Register then Auth > Login first; Login's test script saves the JWT into {{jwt_token}} automatically, and other requests auto-save {{post_id}} / {{comment_id}} for reuse. Not pushed anywhere -- local file only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000", "type": "string" },
    { "key": "demo_username", "value": "", "type": "string", "description": "Set before running Register/Login" },
    { "key": "demo_email", "value": "", "type": "string", "description": "Set before running Register" },
    { "key": "demo_password", "value": "", "type": "string", "description": "Set before running Register/Login -- never commit a real password here" },
    { "key": "jwt_token", "value": "", "type": "string", "description": "Auto-filled by Login's test script" },
    { "key": "post_id", "value": "", "type": "string", "description": "Auto-filled after Create Post" },
    { "key": "comment_id", "value": "", "type": "string", "description": "Auto-filled after Add Comment" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{demo_username}}\",\n  \"email\": \"{{demo_email}}\",\n  \"password\": \"{{demo_password}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.access_token) {",
                  "    pm.collectionVariables.set('jwt_token', body.access_token);",
                  "}",
                  "pm.test('login returned a token', () => pm.expect(body.access_token).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{demo_username}}\",\n  \"password\": \"{{demo_password}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Current User (me)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}" }] },
            "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) { pm.collectionVariables.set('post_id', body.id); }",
                  "pm.test('post created', () => pm.expect(pm.response.code).to.equal(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"5 Tips for Writing Clean FastAPI Code\",\n  \"content\": \"FastAPI makes it easy to build fast, well-typed APIs, but clean structure still matters.\"\n}"
            },
            "url": { "raw": "{{base_url}}/posts", "host": ["{{base_url}}"], "path": ["posts"] }
          }
        },
        {
          "name": "List Posts - Default",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/posts", "host": ["{{base_url}}"], "path": ["posts"] }
          }
        },
        {
          "name": "List Posts - Pagination",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/posts?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["posts"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "List Posts - Search",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/posts?search=fastapi",
              "host": ["{{base_url}}"],
              "path": ["posts"],
              "query": [{ "key": "search", "value": "fastapi" }]
            }
          }
        },
        {
          "name": "List My Posts",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}" }] },
            "url": { "raw": "{{base_url}}/posts/mine", "host": ["{{base_url}}"], "path": ["posts", "mine"] }
          }
        },
        {
          "name": "Get Post by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/posts/{{post_id}}",
              "host": ["{{base_url}}"],
              "path": ["posts", "{{post_id}}"]
            }
          }
        },
        {
          "name": "Update Post",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"5 Tips for Writing Clean, Maintainable FastAPI Code\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/posts/{{post_id}}",
              "host": ["{{base_url}}"],
              "path": ["posts", "{{post_id}}"]
            },
            "description": "Only the author's own post_id succeeds (403 otherwise). Omitted fields are left unchanged."
          }
        },
        {
          "name": "Upload/Replace Post Image",
          "request": {
            "method": "POST",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}" }] },
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "image", "type": "file", "src": "" }]
            },
            "url": {
              "raw": "{{base_url}}/posts/{{post_id}}/image",
              "host": ["{{base_url}}"],
              "path": ["posts", "{{post_id}}", "image"]
            },
            "description": "Set the 'image' form field's file to a local JPG/PNG/WEBP before sending (max 5MB)."
          }
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}" }] },
            "url": {
              "raw": "{{base_url}}/posts/{{post_id}}",
              "host": ["{{base_url}}"],
              "path": ["posts", "{{post_id}}"]
            },
            "description": "Only the author can delete their own post. Run this last so post_id stays valid for the requests above."
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Add Comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) { pm.collectionVariables.set('comment_id', body.id); }",
                  "pm.test('comment created', () => pm.expect(pm.response.code).to.equal(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Great write-up, thanks for sharing!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/posts/{{post_id}}/comments",
              "host": ["{{base_url}}"],
              "path": ["posts", "{{post_id}}", "comments"]
            },
            "description": "Triggers an email notification to the post's author."
          }
        },
        {
          "name": "List Comments on Post",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/posts/{{post_id}}/comments",
              "host": ["{{base_url}}"],
              "path": ["posts", "{{post_id}}", "comments"]
            }
          }
        }
      ]
    },
    {
      "name": "Likes",
      "item": [
        {
          "name": "Like Post",
          "request": {
            "method": "POST",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}" }] },
            "url": {
              "raw": "{{base_url}}/posts/{{post_id}}/like",
              "host": ["{{base_url}}"],
              "path": ["posts", "{{post_id}}", "like"]
            },
            "description": "Triggers an email notification to the post's author."
          }
        },
        {
          "name": "Unlike Post",
          "request": {
            "method": "DELETE",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}" }] },
            "url": {
              "raw": "{{base_url}}/posts/{{post_id}}/like",
              "host": ["{{base_url}}"],
              "path": ["posts", "{{post_id}}", "like"]
            }
          }
        }
      ]
    }
  ]
}
